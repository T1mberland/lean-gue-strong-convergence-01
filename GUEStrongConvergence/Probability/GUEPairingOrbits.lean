/-
# Exact orbit count for the GUE pairings: the face count `c(p)`

This file supplies the missing combinatorial input of the genus expansion of GUE trace-word
moments.  For a fixed word `w` of length `k = 2m` and a pairing `p` of its `k` entries, the exact
finite-`N` pairing expansion of `GUEWordMoments` reduces to the index sum

`∑_{a, d closed} ∏_{(e,f) ∈ p} [label(e) = label(f) ∧ start(e) = end(f) ∧ end(e) = start(f)]`,

and the vertex part of these constraints is generated by the identifications
`v i = v (σ(i) + 1)`, where `σ = partnerPerm p` is the (fixed point free) partner permutation of
`p` (`GUEPairingPositions`) and `+ 1` is the cyclic shift of the `k` entry positions.

The present file formalizes the pure counting statement behind this:

* `card_constant_functions`: for any equivalence relation `s` on a finite type, the number of
  functions `v : α → Fin N` that are constant on `s`-classes is `N ^ #(classes of s)`.
* `forall_apply_eq_iff_sameCycle`: `v i = v (ρ i)` for all `i` holds exactly when `v` is constant
  on the orbits of the cyclic group generated by `ρ`.
* `sum_prod_ite_eq_pow`: consequently the index sum `∑_v ∏_i [v i = v (ρ i)]` equals
  `N ^ (number of orbits of ρ)` for **any** permutation `ρ` of a finite type.
* `pairOrbitPerm` / `pairOrbitCount`: the pairing-specific permutation `i ↦ σ(i) + 1` and its
  orbit count `c(p)`.
* `sum_pairing_indicator_eq_pow` (**main result**): for every pairing `p` of a list `l` the
  index sum over `v : Fin l.length → Fin N` of the product of the Kronecker indicators of the
  constraints `v i = v (σ(i) + 1)` equals `N ^ c(p)`, with no hypothesis on `p` (crossings and odd
  lengths are allowed; the statement is exact in every case).
* `card_pairing_constant_eq_pow`: the same count as the cardinality of the solution set.

The bound `c(p) ≤ m + 1` and the equality characterization are the subject of
`GUEPairingGenus`.
-/
import GUEStrongConvergence.Probability.GUEPairingPositions
import Mathlib.Logic.Equiv.Fin.Rotate
import Mathlib.Data.Fintype.Card
import Mathlib.GroupTheory.Perm.Cycle.Basic

open MeasureTheory ProbabilityTheory Filter
open scoped RealInnerProductSpace Matrix ENNReal Topology

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.style.haveILetI false
set_option linter.unnecessarySimpa false
set_option linter.unusedVariables false

namespace GUEStrongConvergence

attribute [local instance] Classical.propDecidable

noncomputable section

/-! ### Orbits of a permutation -/

/-- The equivalence relation whose classes are the orbits of the cyclic group generated by `ρ`. -/
def sameCycleSetoid {α : Type*} (ρ : Equiv.Perm α) : Setoid α :=
  ⟨Equiv.Perm.SameCycle ρ, Equiv.Perm.SameCycle.equivalence ρ⟩

/-- The number of orbits of the cyclic group generated by a permutation `ρ`, i.e. the number of
cycles of `ρ` (fixed points counting as cycles). -/
def permOrbitCount {α : Type*} [Fintype α] (ρ : Equiv.Perm α) : ℕ :=
  Fintype.card (Quotient (sameCycleSetoid ρ))

/-- A function is invariant under a permutation exactly when it is constant on its orbits. -/
theorem forall_apply_eq_iff_sameCycle {α β : Type*} [Finite α] (ρ : Equiv.Perm α) (v : α → β) :
    (∀ i, v i = v (ρ i)) ↔ ∀ a b, Equiv.Perm.SameCycle ρ a b → v a = v b := by
  constructor
  · intro h a
    have key : ∀ (n : ℕ) (a b : α), (ρ ^ n) a = b → v a = v b := by
      intro n
      induction n with
      | zero => intro a b hb; rw [pow_zero, Equiv.Perm.coe_one, id] at hb; rw [hb]
      | succ n ih =>
        intro a b hb
        rw [pow_succ, Equiv.Perm.mul_apply] at hb
        exact (h a).trans (ih (ρ a) b hb)
    rintro b ⟨n, hn⟩
    obtain ⟨m, hm⟩ := Equiv.Perm.SameCycle.exists_nat_pow_eq (f := ρ) (x := a) (y := b) ⟨n, hn⟩
    exact key m a b hm
  · intro h i
    exact h i (ρ i) ⟨1, by simp⟩

/-- **Counting lemma**: functions into `Fin N` that are constant on the classes of a setoid `s`
are in bijection with functions on the quotient, hence there are `N ^ #(classes)` of them. -/
theorem card_constant_functions {α : Type*} [Fintype α] [DecidableEq α] (N : ℕ) (s : Setoid α) :
    Fintype.card {v : α → Fin N // ∀ a b, s a b → v a = v b} =
      N ^ Fintype.card (Quotient s) := by
  haveI : DecidableEq (Quotient s) := Classical.decEq _
  have h1 : Fintype.card {v : α → Fin N // ∀ a b, s a b → v a = v b} =
      Fintype.card {f : α → Fin N // s ≤ Setoid.ker f} :=
    Fintype.card_congr (Equiv.subtypeEquivRight (fun v =>
      ⟨fun h a b hab => h a b hab, fun h a b hab => Setoid.le_def.mp h hab⟩))
  rw [h1, Fintype.card_congr (Setoid.liftEquiv (β := Fin N) s), Fintype.card_fun,
    Fintype.card_fin]

/-- **Index sum over a permutation**: the sum over all functions `v` of the product of the
indicators of the constraints `v i = v (ρ i)` is `N` to the number of orbits of `ρ`. -/
theorem sum_prod_ite_eq_pow {α : Type*} [Fintype α] [DecidableEq α] (ρ : Equiv.Perm α) (N : ℕ) :
    (∑ v : α → Fin N, ∏ i : α, (if v i = v (ρ i) then (1 : ℂ) else 0)) =
      (N : ℂ) ^ permOrbitCount ρ := by
  have hterm : ∀ v : α → Fin N,
      (∏ i : α, (if v i = v (ρ i) then (1 : ℂ) else 0)) =
        if (∀ i, v i = v (ρ i)) then 1 else 0 := by
    intro v
    simpa using Finset.prod_boole (s := (Finset.univ : Finset α))
      (p := fun i => v i = v (ρ i)) (M₀ := ℂ)
  have hfilter : (Finset.univ.filter fun v : α → Fin N => ∀ i, v i = v (ρ i)) =
      (Finset.univ.filter fun v : α → Fin N =>
        ∀ a b, sameCycleSetoid ρ a b → v a = v b) := by
    refine Finset.filter_congr fun v _ => ?_
    exact forall_apply_eq_iff_sameCycle ρ v
  have hsum : (∑ v : α → Fin N, (if (∀ i, v i = v (ρ i)) then (1 : ℂ) else 0)) =
      ((Finset.univ.filter fun v : α → Fin N => ∀ i, v i = v (ρ i)).card : ℂ) := by
    simpa using Finset.sum_boole (s := (Finset.univ : Finset α → Fin N))
      (p := fun v => ∀ i, v i = v (ρ i)) (R := ℂ)
  have hcast : (Finset.univ.filter fun v : α → Fin N =>
        ∀ a b, sameCycleSetoid ρ a b → v a = v b).card =
      N ^ Fintype.card (Quotient (sameCycleSetoid ρ)) := by
    rw [← Fintype.card_subtype (fun v : α → Fin N =>
      ∀ a b, sameCycleSetoid ρ a b → v a = v b)]
    exact card_constant_functions N (sameCycleSetoid ρ)
  calc (∑ v : α → Fin N, ∏ i : α, (if v i = v (ρ i) then (1 : ℂ) else 0))
      = ∑ v : α → Fin N, (if (∀ i, v i = v (ρ i)) then (1 : ℂ) else 0) :=
        Finset.sum_congr rfl fun v _ => hterm v
    _ = ((Finset.univ.filter fun v : α → Fin N => ∀ i, v i = v (ρ i)).card : ℂ) := hsum
    _ = ((Finset.univ.filter fun v : α → Fin N =>
          ∀ a b, sameCycleSetoid ρ a b → v a = v b).card : ℂ) := by rw [hfilter]
    _ = ((N ^ Fintype.card (Quotient (sameCycleSetoid ρ)) : ℕ) : ℂ) := by rw [hcast]
    _ = (N : ℂ) ^ permOrbitCount ρ := by push_cast; rfl

/-! ### The pairing-specific orbit permutation -/

variable {ι : Type*} [Fintype ι] [DecidableEq ι] {N : ℕ}

/-- The permutation of the entry positions of a pairing given by `i ↦ σ(i) + 1`, where `σ` is the
partner permutation of the pairing and `+ 1` is the cyclic shift.  Its orbits are the faces of the
pairing, so its number of cycles is the face count `c(p)`. -/
def pairOrbitPerm {l : List (GUEEntry ι N)} (p : GUEPairing l) : Equiv.Perm (Fin l.length) :=
  finRotate l.length * partnerPerm p

/-- The face count `c(p)` of a pairing: the number of cycles of `i ↦ σ(i) + 1`. -/
def pairOrbitCount {l : List (GUEEntry ι N)} (p : GUEPairing l) : ℕ :=
  permOrbitCount (pairOrbitPerm p)

@[simp] lemma pairOrbitPerm_apply {l : List (GUEEntry ι N)} (p : GUEPairing l)
    (i : Fin l.length) :
    pairOrbitPerm p i = finRotate l.length (partner l p i) := rfl

/-- **Exact face count for a pairing** (Target 1): the index sum over vertex labellings of the
product of the Kronecker indicators of the constraints `v i = v (σ(i) + 1)` equals `N ^ c(p)`. -/
theorem sum_pairing_indicator_eq_pow {l : List (GUEEntry ι N)} (p : GUEPairing l) :
    (∑ v : Fin l.length → Fin N,
        ∏ i : Fin l.length,
          (if v i = v (pairOrbitPerm p i) then (1 : ℂ) else 0)) =
      (N : ℂ) ^ pairOrbitCount p :=
  sum_prod_ite_eq_pow (α := Fin l.length) (pairOrbitPerm p) N

/-- The same index sum written with the partner permutation and the cyclic shift separately: the
constraints are `v i = v (σ(i) + 1)`. -/
theorem sum_pairing_indicator_eq_pow' {l : List (GUEEntry ι N)} (p : GUEPairing l) :
    (∑ v : Fin l.length → Fin N,
        ∏ i : Fin l.length,
          (if v i = v (finRotate l.length (partner l p i)) then (1 : ℂ) else 0)) =
      (N : ℂ) ^ pairOrbitCount p :=
  sum_pairing_indicator_eq_pow p

end

end GUEStrongConvergence
