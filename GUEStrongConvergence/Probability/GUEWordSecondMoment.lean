/-
# Second moments of GUE trace words: two-trace Wick reduction and variance identity

This file builds the exact second-moment machinery for a fixed GUE trace word, the input to the
`L²`/Borel–Cantelli step of strong convergence.

For a word `w : List ι` of matrix labels let `W = gueWord w x` and `tr_N (W) = gueNormTrace w x`.
The complex GUE matrices are Hermitian (`gueMatrix_conjTranspose`), so the conjugate of the
product `W` is the product of the reversed word:

`conj (tr (gueWord w x)) = tr (gueWord w.reverse x)`

(`star_trace_gueWord`).  Consequently

`‖tr_N (W)‖ ^ 2 = N⁻² tr (gueWord w x) * tr (gueWord w.reverse x)`,

and the exact second moment reduces to the *two-trace* moment `E[tr (W₁) tr (W₂)]`.

The main structural result is the two-trace Wick expansion `integral_trace_mul_trace_gueWord`:

`E[tr (gueWord w₁ x) tr (gueWord w₂ x)] = ∑_{a, b} ∑_{d, e closed} gueWick ((w₁-path) ++ (w₂-path))`,

i.e. a finite sum over the two closed walks and the greedy Wick pairing recursion of the `2k`
concatenated entries, with the delta specialization
`gueTwoTraceWick_eq_delta_sum` (every pairing of the `2k` entries carries the prefactor
`N^{-(k₁+k₂)/2}`), and the label/index factorization
`gueDeltaWeight_eq_label_mul_index` of each pairing's Kronecker weight into a term depending only
on the labels and a term depending only on the matrix indices.

Finally `integral_normSq_sub_integral_gueNormTrace` is the exact variance identity

`∫ ‖tr_N (W) - E tr_N (W)‖ ^ 2 = E[tr_N (W) tr_N (W ^ *)] - ‖E tr_N (W)‖ ^ 2`,

with the right-hand second moment identified with `N⁻² E[tr (W) tr (W ^ *)]` and hence with the
Wick sum `gueTwoTraceWick N w w.reverse`.

## What is *not* proved here

No `O(N⁻²)` variance bound is claimed.  By `gueTwoTraceWick_eq_delta_sum` and
`gueDeltaWeight_eq_label_mul_index`, the remaining work is purely combinatorial and has two parts:

1. the *loop count identity*: for a pairing `p` of the `2k` concatenated entries, the sum of the
   matrix-index weights (`gueIndexWeight`) over all closed-walk index assignments equals
   `N ^ (loop count of p)`, where the loop count is the number of classes of the equivalence
   relation on the `2k` walk vertices generated by the pairs of `p` (each pair identifying the
   start of one entry with the end of its partner and conversely);
2. the *genus inequality*, with equality case: the loop count is at most `k + 2`, and the
   pairings with loop count `k + 2` are exactly the plane (non-crossing) pairings of the two-walk
   surface; the mean-square term `‖E tr_N (W)‖²` cancels their contribution in `Var`, so that
   only pairings with loop count at most `k` survive, each contributing `N^{-2}`.

Neither part is formalized in this repository (the pinned dependency has the corresponding
join-of-pairings loop bounds for the orthogonal Weingarten calculus, but not the GUE/two-walk
genus statement).  All statements below are exact finite-`N` identities valid for every `N`
(including `N = 0`) and every pair of words; no asymptotic statement is made or assumed.
-/
import GUEStrongConvergence.Probability.GUEWordMoments

open MeasureTheory ProbabilityTheory Filter
open scoped RealInnerProductSpace Matrix ENNReal Topology

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.style.haveILetI false
set_option linter.unnecessarySimpa false

namespace GUEStrongConvergence

noncomputable section

variable {ι : Type*} [Fintype ι] [DecidableEq ι] {N : ℕ}

/-! ### The adjoint of a word and the conjugate trace -/

/-- The adjoint of a matrix word is the product of the reversed word. -/
theorem conjTranspose_gueWord (w : List ι) (x : EuclideanSpace ℝ (GUECoord ι N)) :
    (gueWord w x)ᴴ = gueWord w.reverse x := by
  rw [gueWord, Matrix.conjTranspose_list_prod, List.map_map]
  have hcomp : ((fun i => Matrix.conjTranspose (gueMatrix x i)) :
      ι → Matrix (Fin N) (Fin N) ℂ) = fun i => gueMatrix x i := by
    funext i
    exact gueMatrix_conjTranspose x i
  simp only [Function.comp_def]
  rw [hcomp, ← List.map_reverse]
  rfl

/-- The complex conjugate of the trace of a word is the trace of the reversed word. -/
theorem star_trace_gueWord (w : List ι) (x : EuclideanSpace ℝ (GUECoord ι N)) :
    star (Matrix.trace (gueWord w x)) = Matrix.trace (gueWord w.reverse x) := by
  rw [← Matrix.trace_conjTranspose, conjTranspose_gueWord]

/-- The complex conjugate of the normalized trace of a word. -/
theorem star_gueNormTrace (w : List ι) (x : EuclideanSpace ℝ (GUECoord ι N)) :
    star (gueNormTrace w x) = ((N : ℂ)⁻¹) * Matrix.trace (gueWord w.reverse x) := by
  have hsc : star ((N : ℂ)⁻¹) = ((N : ℂ)⁻¹) := by simp
  simp only [gueNormTrace, star_mul, hsc, star_trace_gueWord]
  exact mul_comm _ _

/-! ### The two-trace Wick expansion -/

/-- A product of GUE entries over a concatenated list is the product of the two products. -/
lemma gueProd_append (l₁ l₂ : List (GUEEntry ι N)) (x : EuclideanSpace ℝ (GUECoord ι N)) :
    gueProd (l₁ ++ l₂) x = gueProd l₁ x * gueProd l₂ x := by
  simp [gueProd, List.map_append, List.prod_append]

/-- The concatenated entry list of a closed walk over `w₁` and a closed walk over `w₂`. -/
def guePairEntries (w₁ w₂ : List ι) (a b : Fin N)
    (d : Fin w₁.length → Fin N) (e : Fin w₂.length → Fin N) : List (GUEEntry ι N) :=
  guePathEntries a w₁ d ++ guePathEntries b w₂ e

/-- The concatenated entry list has the summed length. -/
lemma length_guePairEntries (w₁ w₂ : List ι) (a b : Fin N)
    (d : Fin w₁.length → Fin N) (e : Fin w₂.length → Fin N) :
    (guePairEntries w₁ w₂ a b d e).length = w₁.length + w₂.length := by
  simp [guePairEntries, length_guePathEntries]

/-- The two-walk Wick sum: the joint second moment of two trace words, as a finite sum over the
two closed walks and the greedy pairing recursion of the concatenated entries. -/
def gueTwoTraceWick (N : ℕ) (w₁ w₂ : List ι) : ℂ :=
  ∑ a : Fin N, ∑ b : Fin N, ∑ d : (Fin w₁.length → Fin N),
    ∑ e : (Fin w₂.length → Fin N),
      if guePathLast a w₁ d = a ∧ guePathLast b w₂ e = b then
        gueWick (guePairEntries w₁ w₂ a b d e) else 0

/-- The delta-weight version of the two-walk Wick sum. -/
def gueTwoTraceDelta (N : ℕ) (w₁ w₂ : List ι) : ℂ :=
  ∑ a : Fin N, ∑ b : Fin N, ∑ d : (Fin w₁.length → Fin N),
    ∑ e : (Fin w₂.length → Fin N),
      if guePathLast a w₁ d = a ∧ guePathLast b w₂ e = b then
        ∑ p : GUEPairing (guePairEntries w₁ w₂ a b d e), gueDeltaWeight _ p else 0

/-- The integrand attached to one pair of closed walks. -/
def gueTwoTraceIntegrand (w₁ w₂ : List ι) (a b : Fin N)
    (d : Fin w₁.length → Fin N) (e : Fin w₂.length → Fin N)
    (x : EuclideanSpace ℝ (GUECoord ι N)) : ℂ :=
  (if guePathLast a w₁ d = a then gueProd (guePathEntries a w₁ d) x else 0) *
    (if guePathLast b w₂ e = b then gueProd (guePathEntries b w₂ e) x else 0)

/-- Shape of the integrand for a pair of closed walks. -/
lemma gueTwoTraceIntegrand_eq_prod (w₁ w₂ : List ι) (a b : Fin N)
    (d : Fin w₁.length → Fin N) (e : Fin w₂.length → Fin N)
    (h1 : guePathLast a w₁ d = a) (h2 : guePathLast b w₂ e = b) :
    gueTwoTraceIntegrand w₁ w₂ a b d e =
      fun x => gueProd (guePathEntries a w₁ d ++ guePathEntries b w₂ e) x := by
  funext x
  simp only [gueTwoTraceIntegrand, ite_eq_left h1, ite_eq_left h2]
  exact (gueProd_append _ _ x).symm

/-- The integrand vanishes unless both walks close. -/
lemma gueTwoTraceIntegrand_eq_zero (w₁ w₂ : List ι) (a b : Fin N)
    (d : Fin w₁.length → Fin N) (e : Fin w₂.length → Fin N)
    (h : ¬ ((guePathLast a w₁ d = a) ∧ (guePathLast b w₂ e = b))) :
    gueTwoTraceIntegrand w₁ w₂ a b d e = fun _ => (0 : ℂ) := by
  funext x
  by_cases h1 : guePathLast a w₁ d = a
  · have h2 : ¬ guePathLast b w₂ e = b := fun h2 => h ⟨h1, h2⟩
    simp only [gueTwoTraceIntegrand, ite_eq_left h1, ite_eq_right h2, mul_zero]
  · simp only [gueTwoTraceIntegrand, ite_eq_right h1, zero_mul]

/-- Integrability of one pair-of-walks integrand. -/
lemma integrable_gueTwoTraceIntegrand (w₁ w₂ : List ι) (a b : Fin N)
    (d : Fin w₁.length → Fin N) (e : Fin w₂.length → Fin N) :
    Integrable (gueTwoTraceIntegrand w₁ w₂ a b d e)
      (stdGaussian (EuclideanSpace ℝ (GUECoord ι N))) := by
  by_cases h : (guePathLast a w₁ d = a) ∧ (guePathLast b w₂ e = b)
  · rw [gueTwoTraceIntegrand_eq_prod w₁ w₂ a b d e h.1 h.2]
    exact integrable_gueProd _
  · rw [gueTwoTraceIntegrand_eq_zero w₁ w₂ a b d e h]
    exact integrable_zero _ _ _

/-- The integral of one pair-of-walks integrand is the corresponding two-trace Wick term. -/
lemma integral_gueTwoTraceIntegrand (w₁ w₂ : List ι) (a b : Fin N)
    (d : Fin w₁.length → Fin N) (e : Fin w₂.length → Fin N) :
    ∫ x : EuclideanSpace ℝ (GUECoord ι N), gueTwoTraceIntegrand w₁ w₂ a b d e x
        ∂(stdGaussian (EuclideanSpace ℝ (GUECoord ι N))) =
      if guePathLast a w₁ d = a ∧ guePathLast b w₂ e = b then
        gueWick (guePairEntries w₁ w₂ a b d e) else 0 := by
  by_cases h : (guePathLast a w₁ d = a) ∧ (guePathLast b w₂ e = b)
  · rw [gueTwoTraceIntegrand_eq_prod w₁ w₂ a b d e h.1 h.2, ite_eq_left h,
      integral_gueProd_eq_gueWick]
    rfl
  · rw [gueTwoTraceIntegrand_eq_zero w₁ w₂ a b d e h, ite_eq_right h, integral_zero]

/-- Pointwise two-trace expansion into the two closed walks. -/
lemma trace_mul_trace_eq_sum_integrand (w₁ w₂ : List ι)
    (x : EuclideanSpace ℝ (GUECoord ι N)) :
    Matrix.trace (gueWord w₁ x) * Matrix.trace (gueWord w₂ x) =
      ∑ a : Fin N, ∑ b : Fin N, ∑ d : (Fin w₁.length → Fin N),
        ∑ e : (Fin w₂.length → Fin N), gueTwoTraceIntegrand w₁ w₂ a b d e x := by
  rw [trace_gueWord_eq_closedWalkSum, trace_gueWord_eq_closedWalkSum]
  simp only [gueClosedWalkSum]
  rw [Finset.sum_mul_sum]
  refine Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ => ?_
  rw [guePathSumOneShot, guePathSumOneShot, Finset.sum_mul_sum]
  rfl

/-- **Two-trace Wick expansion**: the expectation of the product of two trace words is the finite
sum over the two closed walks of the Wick pairing sum of the concatenated entries. -/
theorem integral_trace_mul_trace_gueWord (w₁ w₂ : List ι) :
    ∫ x : EuclideanSpace ℝ (GUECoord ι N),
        Matrix.trace (gueWord w₁ x) * Matrix.trace (gueWord w₂ x)
        ∂(stdGaussian (EuclideanSpace ℝ (GUECoord ι N))) = gueTwoTraceWick N w₁ w₂ := by
  simp only [gueTwoTraceWick]
  simp_rw [trace_mul_trace_eq_sum_integrand w₁ w₂]
  rw [integral_finsetSum]
  · refine Finset.sum_congr rfl fun a _ => ?_
    rw [integral_finsetSum]
    · refine Finset.sum_congr rfl fun b _ => ?_
      rw [integral_finsetSum]
      · refine Finset.sum_congr rfl fun d _ => ?_
        rw [integral_finsetSum]
        · exact Finset.sum_congr rfl fun e _ => integral_gueTwoTraceIntegrand w₁ w₂ a b d e
        · intro e _
          exact integrable_gueTwoTraceIntegrand w₁ w₂ a b d e
      · intro d _
        exact integrable_finsetSum Finset.univ
          (fun e _ => integrable_gueTwoTraceIntegrand w₁ w₂ a b d e)
    · intro b _
      exact integrable_finsetSum Finset.univ (fun d _ =>
        integrable_finsetSum Finset.univ
          (fun e _ => integrable_gueTwoTraceIntegrand w₁ w₂ a b d e))
  · intro a _
    exact integrable_finsetSum Finset.univ (fun b _ =>
      integrable_finsetSum Finset.univ (fun d _ =>
        integrable_finsetSum Finset.univ
          (fun e _ => integrable_gueTwoTraceIntegrand w₁ w₂ a b d e)))

/-- Integrability of a product of two trace words. -/
theorem integrable_trace_mul_trace_gueWord (w₁ w₂ : List ι) :
    Integrable (fun x : EuclideanSpace ℝ (GUECoord ι N) =>
        Matrix.trace (gueWord w₁ x) * Matrix.trace (gueWord w₂ x))
      (stdGaussian (EuclideanSpace ℝ (GUECoord ι N))) := by
  simp_rw [trace_mul_trace_eq_sum_integrand w₁ w₂]
  exact integrable_finsetSum Finset.univ (fun a _ =>
    integrable_finsetSum Finset.univ (fun b _ =>
      integrable_finsetSum Finset.univ (fun d _ =>
        integrable_finsetSum Finset.univ
          (fun e _ => integrable_gueTwoTraceIntegrand w₁ w₂ a b d e))))

/-! ### The delta form of the two-trace moment -/

/-- The two-walk sum over an explicit pair of pairings, with the full pairing weight. -/
def gueTwoTracePairing (N : ℕ) (w₁ w₂ : List ι) : ℂ :=
  ∑ a : Fin N, ∑ b : Fin N, ∑ d : (Fin w₁.length → Fin N),
    ∑ e : (Fin w₂.length → Fin N),
      if guePathLast a w₁ d = a ∧ guePathLast b w₂ e = b then
        ∑ p : GUEPairing (guePairEntries w₁ w₂ a b d e), GUEPairing.weight _ p else 0

/-- The recursive Wick sum equals the explicit pairing sum, walk by walk. -/
lemma gueTwoTraceWick_eq_pairing (w₁ w₂ : List ι) :
    gueTwoTraceWick N w₁ w₂ = gueTwoTracePairing N w₁ w₂ := by
  simp only [gueTwoTraceWick, gueTwoTracePairing]
  refine Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ =>
    Finset.sum_congr rfl fun d _ => Finset.sum_congr rfl fun e _ => ?_
  by_cases h : (guePathLast a w₁ d = a ∧ guePathLast b w₂ e = b)
  · rw [ite_eq_left h, ite_eq_left h, gueWick_eq_sum_pairing]
  · rw [ite_eq_right h, ite_eq_right h]

/-- **Delta form of the two-trace moment**: every pairing of the `2k` concatenated entries
contributes `N^{-(k₁+k₂)/2}` times its Kronecker weight. -/
theorem gueTwoTracePairing_eq_delta_sum (w₁ w₂ : List ι) :
    gueTwoTracePairing N w₁ w₂ =
      ((N : ℂ)⁻¹) ^ ((w₁.length + w₂.length) / 2) * gueTwoTraceDelta N w₁ w₂ := by
  simp only [gueTwoTracePairing, gueTwoTraceDelta]
  rw [Finset.mul_sum]
  refine Finset.sum_congr rfl fun a _ => ?_
  rw [Finset.mul_sum]
  refine Finset.sum_congr rfl fun b _ => ?_
  rw [Finset.mul_sum]
  refine Finset.sum_congr rfl fun d _ => ?_
  rw [Finset.mul_sum]
  refine Finset.sum_congr rfl fun e _ => ?_
  by_cases h : (guePathLast a w₁ d = a ∧ guePathLast b w₂ e = b)
  · rw [ite_eq_left h, ite_eq_left h, Finset.mul_sum]
    refine Finset.sum_congr rfl fun p _ => ?_
    simp only [weight_eq_inv_pow_mul_deltaWeight, length_guePairEntries]
  · rw [ite_eq_right h, ite_eq_right h, mul_zero]

/-- **Delta form of the two-trace Wick moment.** -/
theorem gueTwoTraceWick_eq_delta_sum (w₁ w₂ : List ι) :
    gueTwoTraceWick N w₁ w₂ =
      ((N : ℂ)⁻¹) ^ ((w₁.length + w₂.length) / 2) * gueTwoTraceDelta N w₁ w₂ := by
  rw [gueTwoTraceWick_eq_pairing, gueTwoTracePairing_eq_delta_sum]

/-! ### Label/index factorization of the Kronecker weight -/

/-- The label part of the GUE covariance kernel. -/
def gueLabelCov (e f : GUEEntry ι N) : ℂ := if e.1 = f.1 then 1 else 0

/-- The matrix-index part of the GUE covariance kernel: the transpose matching. -/
def gueIndexCov (e f : GUEEntry ι N) : ℂ :=
  if e.2.1 = f.2.2 ∧ e.2.2 = f.2.1 then 1 else 0

/-- The Kronecker covariance is the product of its label and index parts. -/
lemma gueDeltaCov_eq_label_mul_index (e f : GUEEntry ι N) :
    gueDeltaCov e f = gueLabelCov e f * gueIndexCov e f := by
  simp only [gueDeltaCov, gueLabelCov, gueIndexCov]
  by_cases h1 : e.1 = f.1 <;> by_cases h2 : (e.2.1 = f.2.2 ∧ e.2.2 = f.2.1) <;>
    simp [h1, h2]

/-- The label weight of a pairing. -/
def gueLabelWeight : (l : List (GUEEntry ι N)) → GUEPairing l → ℂ
  | _, .nil => 1
  | _, .cons e l k p => gueLabelCov e (l.get k) * gueLabelWeight (l.eraseIdx k) p

/-- The matrix-index weight of a pairing. -/
def gueIndexWeight : (l : List (GUEEntry ι N)) → GUEPairing l → ℂ
  | _, .nil => 1
  | _, .cons e l k p => gueIndexCov e (l.get k) * gueIndexWeight (l.eraseIdx k) p

@[simp] lemma gueLabelWeight_nil :
    gueLabelWeight ([] : List (GUEEntry ι N)) (GUEPairing.nil : GUEPairing []) = 1 := rfl

@[simp] lemma gueLabelWeight_cons (e : GUEEntry ι N) (l : List (GUEEntry ι N))
    (k : Fin l.length) (p : GUEPairing (l.eraseIdx k)) :
    gueLabelWeight (e :: l) (GUEPairing.cons e l k p) =
      gueLabelCov e (l.get k) * gueLabelWeight (l.eraseIdx k) p := rfl

@[simp] lemma gueIndexWeight_nil :
    gueIndexWeight ([] : List (GUEEntry ι N)) (GUEPairing.nil : GUEPairing []) = 1 := rfl

@[simp] lemma gueIndexWeight_cons (e : GUEEntry ι N) (l : List (GUEEntry ι N))
    (k : Fin l.length) (p : GUEPairing (l.eraseIdx k)) :
    gueIndexWeight (e :: l) (GUEPairing.cons e l k p) =
      gueIndexCov e (l.get k) * gueIndexWeight (l.eraseIdx k) p := rfl

/-- **Label/index factorization of the pairing weight.**  The label factor depends only on the
labels of the entries (hence not on the matrix indices along the walk); the index factor is the
Kronecker product whose index sum is the loop count. -/
theorem gueDeltaWeight_eq_label_mul_index (l : List (GUEEntry ι N)) (p : GUEPairing l) :
    gueDeltaWeight l p = gueLabelWeight l p * gueIndexWeight l p := by
  induction p with
  | nil => simp [gueDeltaWeight]
  | cons e l k p ih =>
    rw [gueDeltaWeight_cons, gueLabelWeight_cons, gueIndexWeight_cons,
      gueDeltaCov_eq_label_mul_index, ih]
    ring

/-! ### The second moment of the modulus and the variance identity -/

/-- The real part of `z * conj z` is the squared modulus. -/
lemma re_mul_star (z : ℂ) : (z * star z).re = Complex.normSq z := by
  simp only [Complex.star_def, Complex.mul_re, Complex.conj_re, Complex.conj_im,
    Complex.normSq_apply]
  ring

/-- The integral of the real part is the real part of the integral. -/
lemma integral_re_eq {α : Type*} [MeasurableSpace α] {μ : Measure α} {F : α → ℂ}
    (hF : Integrable F μ) :
    ∫ x, (F x).re ∂μ = (∫ x, F x ∂μ).re :=
  Complex.reCLM.integral_comp_comm hF

/-- The squared modulus of the normalized trace is `N⁻²` times the two-trace product of the word
and its reversed word. -/
lemma normSq_gueNormTrace_eq (w : List ι) (x : EuclideanSpace ℝ (GUECoord ι N)) :
    Complex.normSq (gueNormTrace w x) =
      ((N : ℂ)⁻¹ ^ 2 *
        (Matrix.trace (gueWord w x) * Matrix.trace (gueWord w.reverse x))).re := by
  have hmul : gueNormTrace w x * star (gueNormTrace w x) =
      (N : ℂ)⁻¹ ^ 2 *
        (Matrix.trace (gueWord w x) * Matrix.trace (gueWord w.reverse x)) := by
    rw [star_gueNormTrace]
    simp only [gueNormTrace]
    ring
  have hcast : ((Complex.normSq (gueNormTrace w x) : ℝ) : ℂ) =
      (((N : ℂ)⁻¹ ^ 2 *
        (Matrix.trace (gueWord w x) * Matrix.trace (gueWord w.reverse x))).re : ℝ) := by
    rw [← re_mul_star, hmul]
  exact_mod_cast hcast

/-- Integrability of the squared modulus of the normalized trace. -/
theorem integrable_normSq_gueNormTrace (w : List ι) :
    Integrable (fun x : EuclideanSpace ℝ (GUECoord ι N) => Complex.normSq (gueNormTrace w x))
      (stdGaussian (EuclideanSpace ℝ (GUECoord ι N))) := by
  simp_rw [normSq_gueNormTrace_eq w]
  exact Complex.reCLM.integrable_comp
    ((integrable_trace_mul_trace_gueWord w w.reverse).const_mul _)

/-- Integrability of `tr_N (W) * conj (tr_N (W))`. -/
theorem integrable_gueNormTrace_mul_star (w : List ι) :
    Integrable (fun x : EuclideanSpace ℝ (GUECoord ι N) =>
        gueNormTrace w x * star (gueNormTrace w x))
      (stdGaussian (EuclideanSpace ℝ (GUECoord ι N))) := by
  have hpt : ∀ x : EuclideanSpace ℝ (GUECoord ι N),
      gueNormTrace w x * star (gueNormTrace w x) =
        (N : ℂ)⁻¹ ^ 2 *
          (Matrix.trace (gueWord w x) * Matrix.trace (gueWord w.reverse x)) := by
    intro x
    rw [star_gueNormTrace]
    simp only [gueNormTrace]
    ring
  simp_rw [hpt]
  exact (integrable_trace_mul_trace_gueWord w w.reverse).const_mul _

/-- The complex second moment `∫ tr_N (W) conj (tr_N (W))` as the two-trace Wick moment. -/
theorem integral_gueNormTrace_mul_star (w : List ι) :
    ∫ x : EuclideanSpace ℝ (GUECoord ι N), gueNormTrace w x * star (gueNormTrace w x)
        ∂(stdGaussian (EuclideanSpace ℝ (GUECoord ι N))) =
      (N : ℂ)⁻¹ ^ 2 * gueTwoTraceWick N w w.reverse := by
  have hpt : ∀ x : EuclideanSpace ℝ (GUECoord ι N),
      gueNormTrace w x * star (gueNormTrace w x) =
        (N : ℂ)⁻¹ ^ 2 *
          (Matrix.trace (gueWord w x) * Matrix.trace (gueWord w.reverse x)) := by
    intro x
    rw [star_gueNormTrace]
    simp only [gueNormTrace]
    ring
  simp_rw [hpt]
  rw [integral_const_mul, integral_trace_mul_trace_gueWord]

/-- **The squared-modulus second moment**: the squared `L²` norm of the normalized trace is `N⁻²`
times the real part of the two-trace moment of the word and its reversal. -/
theorem integral_normSq_gueNormTrace (w : List ι) :
    ∫ x : EuclideanSpace ℝ (GUECoord ι N), Complex.normSq (gueNormTrace w x)
        ∂(stdGaussian (EuclideanSpace ℝ (GUECoord ι N))) =
      ((N : ℂ)⁻¹ ^ 2 * gueTwoTraceWick N w w.reverse).re := by
  simp_rw [normSq_gueNormTrace_eq w]
  rw [integral_re_eq ((integrable_trace_mul_trace_gueWord w w.reverse).const_mul _),
    integral_const_mul, integral_trace_mul_trace_gueWord]

/-! ### The variance identity -/

/-- **Variance identity for a complex-valued function on a probability measure**:
`∫ ‖f - m‖ ^ 2 = Re ∫ f conj f - ‖m‖ ^ 2` whenever `m = ∫ f`. -/
theorem integral_normSq_sub_integral {α : Type*} [MeasurableSpace α] {μ : Measure α}
    [IsProbabilityMeasure μ] {f : α → ℂ} {m : ℂ}
    (hm : ∫ y, f y ∂μ = m) (hf : Integrable f μ)
    (hA : Integrable (fun x => f x * star (f x)) μ)
    (hnsq : Integrable (fun x => Complex.normSq (f x)) μ) :
    ∫ x, Complex.normSq (f x - m) ∂μ =
      (∫ x, f x * star (f x) ∂μ).re - Complex.normSq m := by
  have hmc : Integrable (fun x => f x * star m) μ := hf.mul_const _
  have hmcr : Integrable (fun x => (f x * star m).re) μ :=
    Complex.reCLM.integrable_comp hmc
  have hstep : ∀ x : α, Complex.normSq (f x - m) =
      (Complex.normSq (f x) - 2 * (f x * star m).re) + Complex.normSq m := by
    intro x
    rw [Complex.normSq_sub]
    simp only [Complex.star_def]
    ring
  simp_rw [hstep]
  rw [integral_add (f := fun x => Complex.normSq (f x) - 2 * (f x * star m).re)
      (g := fun _ => Complex.normSq m) (hnsq.sub (hmcr.const_mul 2)) (integrable_const _),
    integral_sub (f := fun x => Complex.normSq (f x)) (g := fun x => 2 * (f x * star m).re)
      hnsq (hmcr.const_mul 2),
    integral_const, integral_const_mul]
  simp only [probReal_univ, one_smul]
  have hnsq_eq : ∫ x, Complex.normSq (f x) ∂μ = (∫ x, f x * star (f x) ∂μ).re := by
    rw [← integral_re_eq hA]
    exact integral_congr_ae (ae_of_all _ fun x => (re_mul_star (f x)).symm)
  have hfstarr : ∫ x, (f x * star m).re ∂μ = Complex.normSq m := by
    rw [integral_re_eq hmc]
    have hval : ∫ x, f x * star m ∂μ = star m * m := by
      rw [show (fun x => f x * star m) = fun x => star m * f x from
        funext fun x => mul_comm _ _]
      rw [integral_const_mul, hm]
    rw [hval, mul_comm (star m) m, re_mul_star]
  rw [hnsq_eq, hfstarr]
  ring

/-- **Variance identity for a fixed GUE trace word**: the squared `L²` fluctuation of `tr_N (W)`
about its mean equals `N⁻²` times the real part of the two-trace Wick moment of `w` and
`w.reverse`, minus the squared modulus of the mean. -/
theorem integral_normSq_sub_integral_gueNormTrace (w : List ι) :
    ∫ x : EuclideanSpace ℝ (GUECoord ι N),
        Complex.normSq (gueNormTrace w x -
          ∫ y, gueNormTrace w y ∂(stdGaussian (EuclideanSpace ℝ (GUECoord ι N))))
        ∂(stdGaussian (EuclideanSpace ℝ (GUECoord ι N))) =
      ((N : ℂ)⁻¹ ^ 2 * gueTwoTraceWick N w w.reverse).re -
        Complex.normSq (∫ y, gueNormTrace w y
          ∂(stdGaussian (EuclideanSpace ℝ (GUECoord ι N)))) := by
  rw [integral_normSq_sub_integral (μ := stdGaussian (EuclideanSpace ℝ (GUECoord ι N)))
    (f := fun x => gueNormTrace w x)
    (m := ∫ y, gueNormTrace w y ∂(stdGaussian (EuclideanSpace ℝ (GUECoord ι N))))
    rfl (integrable_gueNormTrace w) (integrable_gueNormTrace_mul_star w)
    (integrable_normSq_gueNormTrace w), integral_gueNormTrace_mul_star]

/-- The variance identity in terms of the norm: `∫ ‖tr_N (W) - E tr_N (W)‖ ^ 2` equals the second
moment minus the squared norm of the mean. -/
theorem integral_sq_sub_integral_gueNormTrace (w : List ι) :
    ∫ x : EuclideanSpace ℝ (GUECoord ι N),
        ‖gueNormTrace w x -
          ∫ y, gueNormTrace w y ∂(stdGaussian (EuclideanSpace ℝ (GUECoord ι N)))‖ ^ 2
        ∂(stdGaussian (EuclideanSpace ℝ (GUECoord ι N))) =
      ((N : ℂ)⁻¹ ^ 2 * gueTwoTraceWick N w w.reverse).re -
        Complex.normSq (∫ y, gueNormTrace w y
          ∂(stdGaussian (EuclideanSpace ℝ (GUECoord ι N)))) := by
  rw [← integral_normSq_sub_integral_gueNormTrace w]
  exact integral_congr_ae (ae_of_all _ fun x => (Complex.normSq_eq_norm_sq _).symm)

/-! ### Consistency check: the empty word -/

/-- The two-walk Wick sum of the empty word is `N ^ 2`. -/
theorem gueTwoTraceWick_nil :
    gueTwoTraceWick N ([] : List ι) ([] : List ι) = (N : ℂ) ^ 2 := by
  simp only [gueTwoTraceWick, guePairEntries, guePathEntries_nil, List.nil_append,
    guePathLast_nil, and_self, ite_true, gueWick_nil]
  simp [Finset.sum_const, Finset.card_univ, pow_two]

/-- The variance of the empty word vanishes, as predicted by the variance identity. -/
theorem integral_sq_sub_integral_gueNormTrace_nil (hN : 0 < N) :
    ∫ x : EuclideanSpace ℝ (GUECoord ι N),
        ‖gueNormTrace ([] : List ι) x -
          ∫ y, gueNormTrace ([] : List ι) y
            ∂(stdGaussian (EuclideanSpace ℝ (GUECoord ι N)))‖ ^ 2
        ∂(stdGaussian (EuclideanSpace ℝ (GUECoord ι N))) = 0 := by
  have hNc : (N : ℂ) ≠ 0 := by exact_mod_cast Nat.ne_of_gt hN
  have hkey : (N : ℂ)⁻¹ ^ 2 * (N : ℂ) ^ 2 = 1 := by
    field_simp
  rw [integral_sq_sub_integral_gueNormTrace]
  simp only [List.reverse_nil]
  rw [gueTwoTraceWick_nil, integral_gueNormTrace_nil, ite_eq_right (by simp [hN.ne']), hkey]
  norm_num

end

